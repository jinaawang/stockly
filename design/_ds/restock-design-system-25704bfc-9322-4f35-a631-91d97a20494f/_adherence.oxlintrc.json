{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/brand/**",
              "components/core/**",
              "components/feedback/**",
              "components/forms/**",
              "components/list/**",
              "components/navigation/**",
              "components/surfaces/**",
              "ui_kits/app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Figtree|Manrope))/i]",
        "message": "Font not provided by the design system. Available: Figtree, Manrope."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|tone|size|ring|src|key|ref|className|style|children)$/]",
        "message": "<Avatar> doesn't accept that prop. Declared props: name, tone, size, ring, src."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:lavender|sage|apricot|tangerine|dusk)$/]",
        "message": "<Avatar> tone must be one of 'lavender' | 'sage' | 'apricot' | 'tangerine' | 'dusk'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|dot|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: children, tone, dot."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:tangerine|dusk|sage|cream)$/]",
        "message": "<Badge> tone must be one of 'tangerine' | 'dusk' | 'sage' | 'cream'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|iconLeft|iconRight|fullWidth|disabled|type|onClick|children|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, iconLeft, iconRight, fullWidth, disabled, type, onClick, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|accent|soft|ghost)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'accent' | 'soft' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit)$/]",
        "message": "<Button> type must be one of 'button' | 'submit'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|padding|radius|elevated|bordered|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: children, tone, padding, radius, elevated, bordered, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:default|sunken|lavender|sage|apricot|tangerine|inverse)$/]",
        "message": "<Card> tone must be one of 'default' | 'sunken' | 'lavender' | 'sage' | 'apricot' | 'tangerine' | 'inverse'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CategoryBudget'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|icon|tone|spent|budget|currency|onClick|key|ref|className|style|children)$/]",
        "message": "<CategoryBudget> doesn't accept that prop. Declared props: name, icon, tone, spent, budget, currency, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='CategoryBudget'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:sage|lavender|apricot|tangerine|dusk)$/]",
        "message": "<CategoryBudget> tone must be one of 'sage' | 'lavender' | 'apricot' | 'tangerine' | 'dusk'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Checkbox'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|onChange|label|disabled|size|key|ref|className|style|children)$/]",
        "message": "<Checkbox> doesn't accept that prop. Declared props: checked, onChange, label, disabled, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='GradientCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:gradient|grain|children|padding|radius|minHeight|style|key|ref|className|style|children)$/]",
        "message": "<GradientCard> doesn't accept that prop. Declared props: gradient, grain, children, padding, radius, minHeight, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='GradientCard'] > JSXAttribute[name.name='gradient'] > Literal[value!=/^(?:sunset|dusk|meadow|peach)$/]",
        "message": "<GradientCard> gradient must be one of 'sunset' | 'dusk' | 'meadow' | 'peach'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|color|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, color, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|label|variant|size|disabled|onClick|style|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: icon, label, variant, size, disabled, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:secondary|primary|accent|ghost|glass)$/]",
        "message": "<IconButton> variant must be one of 'secondary' | 'primary' | 'accent' | 'ghost' | 'glass'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|placeholder|value|onChange|iconLeft|iconRight|prefix|type|hint|error|style|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: label, placeholder, value, onChange, iconLeft, iconRight, prefix, type, hint, error, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ItemTile'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|icon|tone|selected|meta|onClick|key|ref|className|style|children)$/]",
        "message": "<ItemTile> doesn't accept that prop. Declared props: label, icon, tone, selected, meta, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='ItemTile'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:sage|lavender|apricot|tangerine|dusk|cream)$/]",
        "message": "<ItemTile> tone must be one of 'sage' | 'lavender' | 'apricot' | 'tangerine' | 'dusk' | 'cream'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PageDots'] > JSXAttribute > JSXIdentifier[name!=/^(?:count|active|onChange|key|ref|className|style|children)$/]",
        "message": "<PageDots> doesn't accept that prop. Declared props: count, active, onChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProgressBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|max|tone|height|autoWarn|track|key|ref|className|style|children)$/]",
        "message": "<ProgressBar> doesn't accept that prop. Declared props: value, max, tone, height, autoWarn, track."
      },
      {
        "selector": "JSXOpeningElement[name.name='Radio'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|onChange|label|disabled|name|key|ref|className|style|children)$/]",
        "message": "<Radio> doesn't accept that prop. Declared props: checked, onChange, label, disabled, name."
      },
      {
        "selector": "JSXOpeningElement[name.name='SegmentedControl'] > JSXAttribute > JSXIdentifier[name!=/^(?:options|value|onChange|fullWidth|size|key|ref|className|style|children)$/]",
        "message": "<SegmentedControl> doesn't accept that prop. Declared props: options, value, onChange, fullWidth, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='SegmentedControl'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<SegmentedControl> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Select'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|options|value|onChange|placeholder|style|key|ref|className|style|children)$/]",
        "message": "<Select> doesn't accept that prop. Declared props: label, options, value, onChange, placeholder, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Sheet'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|onClose|title|children|footer|key|ref|className|style|children)$/]",
        "message": "<Sheet> doesn't accept that prop. Declared props: open, onClose, title, children, footer."
      },
      {
        "selector": "JSXOpeningElement[name.name='ShoppingItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|qty|price|note|checked|onToggle|addedBy|addedByTone|category|onClick|key|ref|className|style|children)$/]",
        "message": "<ShoppingItem> doesn't accept that prop. Declared props: name, qty, price, note, checked, onToggle, addedBy, addedByTone, category, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='ShoppingItem'] > JSXAttribute[name.name='addedByTone'] > Literal[value!=/^(?:lavender|sage|apricot|tangerine|dusk)$/]",
        "message": "<ShoppingItem> addedByTone must be one of 'lavender' | 'sage' | 'apricot' | 'tangerine' | 'dusk'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Stepper'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|min|max|size|addLabel|unit|key|ref|className|style|children)$/]",
        "message": "<Stepper> doesn't accept that prop. Declared props: value, onChange, min, max, size, addLabel, unit."
      },
      {
        "selector": "JSXOpeningElement[name.name='Stepper'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<Stepper> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Sticker'] > JSXAttribute > JSXIdentifier[name!=/^(?:shape|tone|top|main|bottom|icon|size|rotate|ring|italic|shadow|key|ref|className|style|children)$/]",
        "message": "<Sticker> doesn't accept that prop. Declared props: shape, tone, top, main, bottom, icon, size, rotate, ring, italic, shadow."
      },
      {
        "selector": "JSXOpeningElement[name.name='Sticker'] > JSXAttribute[name.name='shape'] > Literal[value!=/^(?:circle|oval|tag|burst)$/]",
        "message": "<Sticker> shape must be one of 'circle' | 'oval' | 'tag' | 'burst'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Sticker'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:tangerine|apricot|sage|lavender|dusk|cream)$/]",
        "message": "<Sticker> tone must be one of 'tangerine' | 'apricot' | 'sage' | 'lavender' | 'dusk' | 'cream'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TabBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|active|onChange|floating|key|ref|className|style|children)$/]",
        "message": "<TabBar> doesn't accept that prop. Declared props: items, active, onChange, floating."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|icon|selected|size|onClick|onRemove|key|ref|className|style|children)$/]",
        "message": "<Tag> doesn't accept that prop. Declared props: children, tone, icon, selected, size, onClick, onRemove."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|lavender|sage|apricot|tangerine|dusk)$/]",
        "message": "<Tag> tone must be one of 'neutral' | 'lavender' | 'sage' | 'apricot' | 'tangerine' | 'dusk'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<Tag> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toggle'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|onChange|label|disabled|key|ref|className|style|children)$/]",
        "message": "<Toggle> doesn't accept that prop. Declared props: checked, onChange, label, disabled."
      }
